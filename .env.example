# ─── Site URL ───────────────────────────────────────────────────────────────────
# Used for metadata (metadataBase), Open Graph, sitemap, robots, and canonical URLs.
# Set to your production domain once Vercel assigns it.
# Falls back to the siteUrl field in Sanity siteSettings if not set.
NEXT_PUBLIC_SITE_URL=https://divyanshsingh.com

# ─── Sanity CMS — Public ───────────────────────────────────────────────────────
# Embedded in client bundle (safe to expose). Required for build to succeed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01

# ─── Sanity CMS — Private (server-only) ────────────────────────────────────────
# Used for draft preview fetching and as the draft-mode enable secret.
# Never prefix with NEXT_PUBLIC_ — must remain server-only.
SANITY_API_READ_TOKEN=

# Used to validate incoming revalidation webhook requests from Sanity.
# Must match the secret configured in the Sanity webhook.
SANITY_REVALIDATE_SECRET=

# ─── Migration Only (optional) ─────────────────────────────────────────────────
# Used only by scripts/migrate-to-sanity.ts for writing content.
# Not needed at runtime. Do NOT deploy this to Vercel.
# SANITY_API_WRITE_TOKEN=
